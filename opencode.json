{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "mcp": {
    "servers": {
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.0.0",
          "mcp"
        ],
        "disabled": false
      },
      "orbit": {
        "type": "local",
        "command": [
          "python",
          "A:/system/scripts/orbit_mcp_server.py"
        ],
        "disabled": false
      }
    }
  }
}
