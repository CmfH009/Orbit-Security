# Orbit Security Outbound Email Configuration
# Copy this file to .env and fill in your details:

# Gmail, Microsoft 365, or standard SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com

# For Gmail: Use a Google Account "App Password" (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=your_16_digit_app_password

# Sender display name
SENDER_NAME=Carson | Founder, Orbit Security

# Default Agency Details for Co-Branded PDF Reports
DEFAULT_AGENCY_NAME=Apex Digital Studio
DEFAULT_AGENCY_TAGLINE=Managed Web & Security Operations
DEFAULT_AGENCY_EMAIL=your_email@gmail.com
DEFAULT_AGENCY_WEBSITE=https://yourportfolio.com

# Stripe Configuration
# Keys from https://dashboard.stripe.com/test/apikeys (test) or /apikeys (live)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PAYMENT_LINK=https://buy.stripe.com/4gM14m1Fq2QXetya4Qcs800

# Stripe Price IDs for monthly subscription tiers (create in Stripe Dashboard > Products)
# Tiers: Starter $299/mo, Scale $499/mo, Enterprise $999/mo
STRIPE_PRICE_STARTER=price_starter_299_monthly
STRIPE_PRICE_SCALE=price_scale_499_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_999_monthly

# Self-service checkout server (stdlib http.server, localhost only)
STRIPE_CHECKOUT_PORT=8089
STRIPE_CHECKOUT_BASE_URL=http://localhost:8089
